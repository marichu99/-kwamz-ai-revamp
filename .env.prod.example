# =============================================================================
# Kwamz AI Production Environment Configuration
# =============================================================================
# Copy this file to .env.prod and update with your production values
# NEVER commit .env.prod to version control!

# Domain Configuration
DOMAIN=your-domain.com
EMAIL=your-email@example.com

# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here

# MinIO Configuration (S3-compatible object storage)
MINIO_ROOT_USER=your_minio_admin_user
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_BUCKET=kwamz-files

# Flask Configuration
FLASK_SECRET_KEY=your_very_long_random_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# OpenAI (if used)
OPENAI_API_KEY=your_openai_api_key

# Google Cloud Storage (if used)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
